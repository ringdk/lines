# ~/.config/systemd/user/lines-backup.service (linked from the checkout)
# An encrypted copy of Lines's database on the backup disk, hourly
# (lines-backup.timer), only when it has changed: <db>-latest.db, one
# dated copy a day (never removed), and the secrets.age that opens them. Made
# through SQLite under the same key, so what lands on the disk is ciphertext.
# A light app's: yours, like the app.
[Unit]
Description=Lines: encrypted copy of the database to the backup disk
RequiresMountsFor=/mnt/media

[Service]
Type=oneshot
EnvironmentFile=%h/.config/lines/env
# this app's own: its other settings
# end of this app's own
Environment=PYTHONDONTWRITEBYTECODE=1
WorkingDirectory=%h/workspace/lines
ExecStart=%h/workspace/lines/.venv/bin/lines backup /mnt/media/lines-backup
UMask=0077

NoNewPrivileges=yes
LockPersonality=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
SystemCallArchitectures=native
SystemCallFilter=@system-service
SystemCallFilter=~@privileged
