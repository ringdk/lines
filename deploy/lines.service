# ~/.config/systemd/user/lines.service (linked from the checkout)
# Lines, a light app (serafina/docs/APPS.md, "Light apps"): it keeps
# nothing personal, so it runs as you, from ~/workspace/lines, under your
# own systemd (lingering keeps it up while you're logged out). No system user
# and no sudo: it can reach what you can, as Serafina can, which is the
# point of being light. A light app never holds anyone else's credential.
#
# One listener, loopback :8795, for Serafina only: her app proxy (/ui, signed
# identity) and her MCP client (/mcp, bearer token).
[Unit]
Description=Lines: an app beside Serafina (loopback :8795)
After=network-online.target

[Service]
Type=simple
# Who may use it, where its data lives, and the passphrase for its
# secrets.age: a file only you can read (docs/deploy-astarte.md).
EnvironmentFile=%h/.config/lines/env
# this app's own: its other settings
# end of this app's own
Environment=PYTHONDONTWRITEBYTECODE=1
WorkingDirectory=%h/workspace/lines
ExecStart=%h/workspace/lines/.venv/bin/lines serve
Restart=on-failure
RestartSec=5
UMask=0077

# What an unprivileged unit can still hold back.
NoNewPrivileges=yes
LockPersonality=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
SystemCallArchitectures=native
SystemCallFilter=@system-service
SystemCallFilter=~@privileged

[Install]
WantedBy=default.target
