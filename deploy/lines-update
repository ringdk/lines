#!/bin/sh
# lines-update: build what's checked out in ~/workspace/lines and
# restart Lines. A light app's update script, from Serafina's app
# template (serafina/templates/app; serafina/docs/APPS.md, "Light apps").
# Run it from the checkout, as you:
#
#   git -C ~/workspace/lines pull --ff-only && ~/workspace/lines/deploy/lines-update
#
# A light app keeps nothing personal, so it runs as you, from this checkout,
# under your own systemd: no system user, no signing key, no sudo. The pull
# before it is yours; this builds main as it is and restarts the service.
set -eu

APP="$HOME/workspace/lines"
LOCK="$HOME/.cache/lines-update.lock"
UV=/usr/local/bin/uv
# this app's own: the pyproject extras it installs, by name, such as "embeddings"
EXTRAS=""
# end of this app's own

case "$*" in
    "") ;;
    *) echo "usage: lines-update" >&2; exit 2 ;;
esac

if [ "$(id -u)" -eq 0 ]; then
    echo "lines-update: run it as yourself: a light app is yours, never root's" >&2
    exit 1
fi

mkdir -p "${LOCK%/*}"
exec 9>"$LOCK"
flock -n 9 || { echo "lines-update: another update is running" >&2; exit 1; }

note() { logger -t lines-update "$*" 2>/dev/null || true; }

cd "$APP"
# What runs is main as pulled, never a branch or an edit in passing.
branch=$(git symbolic-ref --quiet --short HEAD || echo "(detached)")
if [ "$branch" != main ]; then
    echo "lines-update: $APP is on $branch; it deploys only main" >&2
    exit 1
fi
if [ -n "$(git status --porcelain --untracked-files=no)" ]; then
    echo "lines-update: $APP has changes that aren't committed; not deploying them" >&2
    git status --short --untracked-files=no >&2
    exit 1
fi

# Names only: nothing but `--extra NAME` reaches uv.
extra_args=""
for extra in $EXTRAS; do
    case "$extra" in
        *[!a-z0-9_-]*) echo "lines-update: '$extra' isn't an extra's name" >&2; exit 1 ;;
    esac
    extra_args="$extra_args --extra $extra"
done

"$UV" sync --quiet --frozen --no-dev $extra_args --python 3.12
(cd frontend && npm ci --ignore-scripts --no-audit --no-fund --loglevel=error && npm run --silent build)
if [ ! -f frontend/dist/index.html ] || [ -n "$(find frontend/dist ! -type f ! -type d -print -quit)" ]; then
    echo "lines-update: the frontend build left no page, or something other than plain files" >&2
    exit 1
fi
note "built $(git rev-parse --short HEAD)"

# Restart and wait until it answers, so whatever runs next doesn't race it.
if systemctl --user is-enabled --quiet lines.service 2>/dev/null; then
    systemctl --user daemon-reload
    systemctl --user restart lines.service
    tries=0
    until curl -fsS --max-time 2 http://127.0.0.1:8795/health >/dev/null 2>&1; do
        tries=$((tries + 1))
        if [ "$tries" -ge 60 ]; then
            echo "lines restarted but isn't answering; see: journalctl --user -u lines -n 30" >&2
            exit 1
        fi
        sleep 1
    done
    echo "Restarted lines on $(git log --oneline -1); it's answering."
else
    echo "Built $(git log --oneline -1); lines.service isn't enabled yet (docs/deploy-astarte.md)."
fi
