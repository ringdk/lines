# ~/.config/lines/env: Lines's settings and the passphrase that
# opens its secrets.age. Yours, 0600, made by docs/deploy-astarte.md; the
# service, its backups and the CLI all read it. Never commit it.

# Who may use it: the emails Serafina vouches for, comma-separated. The same
# list holds for its pages and its tools.
LINES_USERS=ringdk@gmail.com
LINES_PORT=8795
LINES_DATA_DIR=/home/danring/.local/share/lines
# A long random value, filled in at install.
LINES_AGE_PASSPHRASE=
