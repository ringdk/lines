# /etc/lines/lines.env: settings for lines.service that aren't
# secret. Root-owned, 0644. Secrets go in /var/lib/lines/secrets.age
# (lines-admin), never here.

# Who may use it: the emails Serafina vouches for, comma-separated. The same
# list holds for its pages and its tools.
LINES_USERS=ringdk@gmail.com
LINES_PORT=8794
